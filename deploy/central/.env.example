# Copy to .env next to docker-compose.yml. Never commit the real file.

# Image to run: tag AND digest (a tag alone can be moved). The digest:
#   docker buildx imagetools inspect ghcr.io/josegustavo/plumb-mcp:<tag>
PLUMB_IMAGE=ghcr.io/josegustavo/plumb-mcp:1.0.0@sha256:0e697f0af338b2c9f5f3ecaa23bac8e092e1ded15dab560d504740148758bf09

# Key the Figma plugin must send to pair. Generate: openssl rand -base64 24
PLUMB_PAIR_SECRET=

# Bearer token MCP clients (or your gateway) send to /mcp. Generate: openssl rand -base64 32
PLUMB_MCP_TOKEN=

# Optional: comma-separated Figma file names the plugin may serve.
PLUMB_ALLOWED_FILES=

# Optional: comma-separated tool names, or "all". Empty = read-only hosted set.
PLUMB_TOOLS=

# Optional: Figma personal access token (free, read-only scopes) for
# plumb_comments, plumb_versions, plumb_files and plumb_library. Design reads
# go through the plugin and never use it.
FIGMA_TOKEN=

# Optional: default file for plumb_comments / plumb_versions (the string after
# /design/ in the file URL), so requests needn't paste the link.
PLUMB_FILE_KEY=

# Optional: default team for plumb_files / plumb_library (figma.com/files/team/<id>/…).
PLUMB_TEAM_ID=
